@model MVCOgrenciTakip25.Models.TBLOGRENCİ
@{
    ViewBag.Title = "OgrenciGetir";
    Layout = "~/Views/Shared/LayoutOgrenci.cshtml";
}

<h2>Ogrenci Güncelleme</h2>
@using (Html.BeginForm("Guncelle", "Ogreci", FormMethod.Post))
{
    <div class="form-group">
        @*<label>Öğrenci Id</label> HiddenFor Id Görünmez Yapar*@
        @Html.HiddenFor(x => x.OGRID, new { @class = "form-control" ,@readonly="readonly"})
    </div>
    <div class="form-group">
        <label>Öğrenci Adı</label>
        @Html.TextBoxFor(x => x.OGRADI, new { @class = "form-control" })
    </div>
    <div class="form-group">
        <label>Öğrenci Soyadı</label>
        @Html.TextBoxFor(x => x.OGRSOYAD, new { @class = "form-control" })
    </div>
    <div class="form-group">
        <label>Öğrenci Şehir</label>
        @Html.TextBoxFor(x => x.OGRSEHIR, new { @class = "form-control" })
    </div>
    <button class="btn btn-primary">Kaydet</button>
}

